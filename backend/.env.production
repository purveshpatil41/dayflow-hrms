# Production Environment Configuration for Render
# Do not commit real production secrets in this file. Add actual values in the
# Render dashboard or through render.yaml secret placeholders.
NODE_ENV=production
PORT=5000

# Database Configuration
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=dayflow_hrms
DB_DIALECT=mysql

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=7d

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Frontend URL (update with your deployed frontend URL)
FRONTEND_URL=https://dayflow-hrms.onrender.com
